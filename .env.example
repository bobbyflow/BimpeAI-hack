# Copy to your shell env. DO NOT put the real key in a committed file.
# Get the team API key from Bobby via the team chat (WhatsApp/Slack), not from git.
#
#   macOS/Linux:   export BIMPE_API_KEY=sk_...
#   PowerShell:    $env:BIMPE_API_KEY='sk_...'
#
BIMPE_API_KEY=sk_your_team_key_here

# Optional — defaults to https://api.bimpe.ai/api/v1/console
# BIMPE_BASE_URL=https://api.bimpe.ai/api/v1/console
